<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>smartcommands</id>
    <name>Smart Picker Commands</name>
    <summary>Smart Picker command lists for bots and agents in Talk</summary>
    <description><![CDATA[
Smart Picker Commands lets bots, agents, and integrations publish their own command lists into the Nextcloud Smart Picker (the "/" menu) in Talk and other rich-text surfaces.

Each publisher owns its command manifest, so the picker becomes a shared, room-aware command-discovery layer with no hard-coded local commands.
    ]]></description>
    <version>0.7.8</version>
    <licence>agpl</licence>
    <author mail="">Lance</author>
    <namespace>SmartCommands</namespace>
    <category>integration</category>
    <bugs>https://github.com/ShapeShifter499/smartcommands/issues</bugs>
    <website>https://github.com/ShapeShifter499/smartcommands</website>
    <repository type="git">https://github.com/ShapeShifter499/smartcommands.git</repository>
    <dependencies>
        <nextcloud min-version="29" max-version="34"/>
        <php min-version="8.1"/>
    </dependencies>
    <settings>
        <admin>OCA\SmartCommands\Settings\Admin</admin>
        <admin-section>OCA\SmartCommands\Settings\Section</admin-section>
        <personal>OCA\SmartCommands\Settings\Personal</personal>
        <personal-section>OCA\SmartCommands\Settings\Section</personal-section>
    </settings>
</info>
